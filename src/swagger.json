{
  "swagger": "2.0",
  "info": {
    "description": "HTTP API for substring lookup against one or more in-memory full-text index files.",
    "version": "1.1.0",
    "title": "Generic Substring Lookup API",
    "contact": {
      "email": "bjorn.reppen@artsdatabanken.no"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "basePath": "/v1",
  "schemes": ["https", "http"],
  "produces": ["application/json"],
  "paths": {
    "/query": {
      "get": {
        "summary": "Search the substring index",
        "description": "Returns up to 20 ranked matches for the given query string. If `q` is missing or empty, the API returns the contents of `emptyquery.json` as a sample of the data type. If there are no matches, the API returns the contents of `nohits.json`.",
        "operationId": "query",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Substring or phrase to search for",
            "required": false,
            "type": "string",
            "default": "lecanorales",
            "x-example": "lecanorales"
          }
        ],
        "responses": {
          "200": {
            "description": "Query executed successfully",
            "schema": {
              "$ref": "#/definitions/QueryResponse"
            },
            "examples": {
              "application/json": {
                "query": "lecanorales",
                "result": [
                  {
                    "score": 9.13,
                    "title": "Kantlavordenen",
                    "url": "Biota/Fungi/Ascomycota/Pezizomycotina/Lecanoromycetes/Lecanorales"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "QueryResponse": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "example": "lecanorales"
        },
        "result": {
          "type": "array",
          "description": "Array of ranked result objects. For empty queries or no-hit cases, the contents depend on the configured fallback JSON files.",
          "items": {
            "$ref": "#/definitions/LookupResult"
          }
        }
      }
    },
    "LookupResult": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "format": "float",
          "example": 9.13
        },
        "title": {
          "type": "string",
          "example": "Kantlavordenen"
        },
        "url": {
          "type": "string",
          "example": "Biota/Fungi/Ascomycota/Pezizomycotina/Lecanoromycetes/Lecanorales"
        }
      },
      "additionalProperties": true
    }
  },
  "externalDocs": {
    "description": "Find out more about generic-substring-lookup-api on GitHub",
    "url": "https://github.com/Artsdatabanken/generic-substring-lookup-api"
  }
}
